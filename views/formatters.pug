//- Renders an anchor only for http(s)/ftp(s) URLs — the schemes the CVE
//- schema itself permits for reference and repo URLs. Any other scheme
//- (javascript:, data:, vbscript:, …) falls back to inert text, since these
//- URLs come from document data that may be authored by another org.
mixin safeLink(url)
    - var su ; try { var pu = (new URL(url)); if (pu.protocol === 'http:' || pu.protocol === 'https:' || pu.protocol === 'ftp:' || pu.protocol === 'ftps:') su = pu; } catch(e){};
    if su
        a(href=su.href)&attributes(attributes)
            block
    else
        - var sattrs = {}; for (var k in attributes) { if (k !== 'target' && k !== 'rel' && k !== 'href' && k !== 'title') { sattrs[k] = attributes[k]; } }
        span(title=url)&attributes(sattrs)
            block

mixin compactNumber(value)
    if value === undefined || value === null || value === ''
        span.tgrey -
    else
        - var num = Number(value);
        if isNaN(num)
            = value
        else
            - var abs = Math.abs(num);
            - var divisor = 1;
            - var suffix = '';
            - if (abs >= 1000000000) { divisor = 1000000000; suffix = 'b'; }
            - else if (abs >= 1000000) { divisor = 1000000; suffix = 'm'; }
            - else if (abs >= 1000) { divisor = 1000; suffix = 'k'; }
            - var scaled = num / divisor;
            - var rounded = divisor === 1 ? num : (Math.abs(scaled) >= 10 ? Math.round(scaled) : Math.round(scaled * 10) / 10);
            - var text = divisor === 1 ? num.toLocaleString('en-US', { maximumFractionDigits: 2 }) : ((Number.isInteger(rounded) ? String(rounded) : rounded.toFixed(1).replace(/\.0$/, '')) + suffix);
            span(title=String(value))= text
